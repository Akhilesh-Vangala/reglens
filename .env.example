# Which client to use: azure (Azure OpenAI), openai (OpenAI API / compatible endpoint) or anthropic (Claude API)
LLM_PROVIDER=azure

# Azure OpenAI (Azure AI Foundry): deployment NAMES you created, not model names
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# If LLM_PROVIDER=anthropic (chat only; retrieval uses the local bge model)
# ANTHROPIC_API_KEY=
# ANTHROPIC_CHAT_MODEL=claude-haiku-5-5

# If LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=            (optional, for an OpenAI-compatible gateway)

# Azure AI Search (Free tier is enough for this corpus)
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=reglens-2026-10-02

# Prices in USD per 1M tokens, copied from the Azure pricing page for YOUR region/deployment.
# Leave blank and reports will say "not priced" instead of inventing a number.
PRICE_INPUT_PER_M=
PRICE_OUTPUT_PER_M=
PRICE_EMBEDDING_PER_M=

# Optional: ship traces to any OTLP backend (Phoenix, OpenTelemetry Collector -> Azure Monitor)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
