# Chat model provider: anthropic (Claude API), azure (Azure OpenAI) or openai (OpenAI / compatible gateway).
# Embeddings are always local (bge-small-en-v1.5), so no provider needs an embeddings endpoint.
LLM_PROVIDER=anthropic

# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-5-5

# LLM_PROVIDER=azure (deployment NAME you created, not the model name)
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=            (optional, for an OpenAI-compatible gateway)

# USD per 1M tokens from the provider's pricing page for YOUR model. Model runs refuse to start without them.
PRICE_INPUT_PER_M=0.10
PRICE_OUTPUT_PER_M=0.50

# Hard cap in USD across all model runs on this machine (tracked in traces/spend.json).
REGLENS_USD_CAP=10

# Public deployment limits (Redis via Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN)
# REGLENS_RATE_PER_HOUR=10
# REGLENS_DAILY_USD_CAP=1.00

# Stores (docker compose / Kubernetes set these): Qdrant vector search and Neo4j citation graph
# REGLENS_RETRIEVER=qdrant_bge
# QDRANT_URL=http://localhost:6333
# NEO4J_URI=bolt://localhost:7687
# NEO4J_PASSWORD=

# Optional: ship traces to any OTLP backend (Phoenix, OpenTelemetry Collector -> Azure Monitor)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
