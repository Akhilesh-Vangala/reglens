{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "{src/**,data/processed/**,data/raw/manifest.json,evals/golden.jsonl,evals/reports/**/summary.json}",
      "excludeFiles": "{tests/**,scripts/**,docs/**,data/raw/*.xml,evals/reports/**/results.jsonl,**/__pycache__/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
