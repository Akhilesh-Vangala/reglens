{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "{backend/src/**,frontend/public/**,data/processed/**,data/demo/**,data/raw/manifest.json,evals/golden.jsonl,evals/reports/**/summary.json}",
      "excludeFiles": "{backend/tests/**,backend/scripts/**,frontend/e2e/**,docs/**,data/raw/*.xml,evals/reports/**/results.jsonl,**/__pycache__/**}"
    }
  }
}
